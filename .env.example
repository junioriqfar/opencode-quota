# PostgreSQL
DATABASE_URL=postgres://quota_app:change-me@127.0.0.1:5432/quota_status

# App
APP_URL=https://quota.example.com
PORT=8787
HOST=127.0.0.1
NODE_ENV=production
COOKIE_SECURE=true

# Secrets (generate with: openssl rand -base64 32)
SESSION_SECRET=
APP_ENCRYPTION_KEY=

# Bootstrap super-admin (used once by /setup)
# Development: leave empty to auto-generate and print once in the server log.
# Production: set a strong value, otherwise setup is disabled.
SETUP_TOKEN=

# Email (Resend). Leave empty for dev logging.
EMAIL_FROM=Quota Status <noreply@example.com>
RESEND_API_KEY=

# Cloudflare Turnstile (optional in dev)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dev helpers
DEV_EXPOSE_EMAIL_LINKS=false
SYNC_INTERVAL_MS=600000
PLAN_PRICE_USD=10
V1_DB_PATH=../quota-status/data/quota.db

# Optional: seed:dev super-admin (a random password is generated when empty)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
