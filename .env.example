# PostgreSQL
# Production requires DATABASE_URL; there is no fallback.
# URL-encode special characters in the password.
DATABASE_URL=postgres://quota_app:change-me@127.0.0.1:5432/opencode_quota

# App
# Production requires an https:// APP_URL. The __Host- session cookie depends on it.
APP_URL=https://quota.example.com
PORT=8788
HOST=127.0.0.1
NODE_ENV=production
COOKIE_SECURE=true

# Secrets (generate with: openssl rand -base64 32)
SESSION_SECRET=
APP_ENCRYPTION_KEY=

# Bootstrap super-admin (used once by /setup)
# Development: leave empty to auto-generate and print once in the server log.
# Production: set a strong value, otherwise setup is disabled.
SETUP_TOKEN=

# Email (Resend). Empty in production: verification and reset emails are not delivered.
EMAIL_FROM=OpenCode Quota <noreply@example.com>
RESEND_API_KEY=

# Cloudflare Turnstile (required in production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dev helpers
DEV_EXPOSE_EMAIL_LINKS=false
SYNC_INTERVAL_MS=600000
PLAN_PRICE_USD=10
V1_DB_PATH=../quota-status/data/quota.db

# Optional: seed:dev super-admin (a random password is generated when empty)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
