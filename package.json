{
  "name": "quota-status-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "bun --watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "bun src/server.ts",
    "cli": "bun src/cli.ts",
    "setup": "bun src/cli.ts setup",
    "migrate:v1": "bun src/cli.ts migrate:v1",
    "seed:dev": "bun src/cli.ts seed:dev",
    "test": "bun test",
    "build:win": "bun run build:web && bun build --compile --target=bun-windows-x64 src/server.ts --outfile dist/quota.exe && bun build --compile --target=bun-windows-x64 src/cli.ts --outfile dist/quota-cli.exe"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "lucide-react": "^0.460.0",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
